# Nexus Backend Environment Variables

# Server
# The dev default is 5100 (see frontend .env.example — NEXT_PUBLIC_API_URL has to
# point at the same port or every request from the browser is refused).
PORT=5100
# Must be `production` in production — it is what disables the loopback CORS
# shortcut below. Render does not set it automatically.
NODE_ENV=development

# Database
MONGO_URI=backend

# Database tooling
#   npm run db:indexes   — build indexes from the schemas
#   npm run db:seed      — reset collections and insert development seed data
#   npm run db:reset     — drop the entire database, then re-seed

# Auth
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=replace with expiration time
SALT_ROUNDS=replace

# CORS — the frontend origins allowed to call this API with credentials.
# Governs both the HTTP layer and the Socket.IO handshake, from one policy.
#
#   ALLOWED_ORIGINS   Comma-separated list of trusted origins. Set this on
#                     Render. The variable to edit when a deployment domain
#                     changes — no code change, no redeploy of the image.
#   CLIENT_URL        The original single-origin variable. Still honoured, and
#                     merged with ALLOWED_ORIGINS rather than replaced, so an
#                     existing deployment that only sets this keeps working.
#   NODE_ENV          Must be `production` in production. Any other value also
#                     allows every loopback origin on any port
#                     (http://localhost:3000, :5000, :5100, 127.0.0.1, ...),
#                     so developers never have to enumerate their own port.
#                     Render does not set this for you — set it explicitly, or
#                     the loopback shortcut stays live on the public service.
#
# `*` is never sent: it is illegal alongside `credentials: true`. An unlisted
# origin is refused by omitting the CORS response header, not by a wildcard.
ALLOWED_ORIGINS=http://localhost:3000,https://nexus-vyd1.vercel.app
CLIENT_URL=http://localhost:3000

# Transactional email — Brevo (https://app.brevo.com), under "SMTP & API".
# The code sends over Brevo's REST API, reading BREVO_API_KEY. When it is empty
# or the sender is unset, sending is skipped with a log line — sign-up and
# invitations still succeed, they simply send no mail.
BREVO_API_KEY=
# Only used as a fallback if BREVO_API_KEY is unset, or if you switch to SMTP.
BREVO_SMTP_KEY=
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
# Sender shown on outgoing mail. Must be a Brevo-verified sender address;
# falls back to BREVO_SMTP_LOGIN when unset.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Nexus

# Deliverable uploads (Phase 12)
# Where uploaded files are written, relative paths resolve from backend/.
UPLOAD_DIR=uploads
# Hard ceiling per file in bytes (default 10 MiB).
DELIVERABLE_MAX_FILE_SIZE=size
# Comma-separated MIME allowlist. Leave empty for the built-in list of
# documents, archives, images, audio and video (see services/storage.service.js).
DELIVERABLE_ALLOWED_MIME_TYPES=

# Profile pictures (Phase 23)
# Hard ceiling per avatar in bytes (default 2 MiB). Images only — the format is
# confirmed from the file's magic bytes, and the extension is chosen server-side.
AVATAR_MAX_FILE_SIZE=2097152
# Absolute origin used to build the avatar URL stored on the user. Set it when
# the API sits behind a proxy that terminates TLS; otherwise the origin is
# reconstructed from the request's X-Forwarded-Proto and Host headers.
PUBLIC_BASE_URL=