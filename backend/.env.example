# Nexus Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/nexus

# Database tooling
#   npm run db:indexes   — build indexes from the schemas
#   npm run db:seed      — reset collections and insert development seed data
#   npm run db:reset     — drop the entire database, then re-seed

# Auth
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
SALT_ROUNDS=10

# CORS — the frontend origin allowed to call this API with credentials
CLIENT_URL=http://localhost:3000