# Nexus Frontend Environment Variables
#
# Copy to .env.local (git-ignored) and adjust. Next.js only exposes variables
# prefixed with NEXT_PUBLIC_ to the browser, so nothing secret belongs here —
# secrets for the Google provider stay server-side in the same file and are only
# read by the NextAuth route.

# Base URL of the Express API, including the /api prefix.
# This is the value the whole frontend calls, and it must match the backend's
# PORT. The code falls back to http://localhost:5100/api when it is unset, which
# matches backend/.env.example; if you change PORT there, change it here too.
NEXT_PUBLIC_API_URL=http://localhost:5100/api

# Optional. Comma-separated email domains shown as a hint on the sign-in form,
# e.g. "university.edu,lab.org". Purely cosmetic: it does not restrict who can
# register. Leave empty to hide the hint.
NEXT_PUBLIC_INSTITUTE_DOMAINS=

# Optional. Google sign-in is only offered when both of these are set. Note that
# the Google flow runs through NextAuth and does NOT establish the Express
# cookie session used by the rest of the app, so a Google user is not signed in
# to the API. Email/password sign-in is the supported path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
